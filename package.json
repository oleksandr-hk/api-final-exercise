{
  "name": "dojo.api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "test": "npx playwright test",
    "test:admin": "npx playwright test --grep @Admin",
    "test:auth": "npx playwright test --grep @Auth",
    "test:register": "npx playwright test --grep @Register",
    "test:oauth": "npx playwright test --grep @OAuth2",
    "test:courses": "npx playwright test --grep @Courses",
    "test:learning-paths": "npx playwright test --grep @Learning-path",
    "test:posts": "npx playwright test --grep @Posts",
    "test:promo-codes": "npx playwright test --grep @Promo-code",
    "test:purchases": "npx playwright test --grep @Purchases",
    "test:tags": "npx playwright test --grep @Tags"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@scalar/nextjs-api-reference": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.0.11",
    "mariadb": "^3.5.2",
    "next": "16.2.1",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
